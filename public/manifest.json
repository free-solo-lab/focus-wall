{
  "manifest_version": 3,
  "name": "Focus Wall",
  "version": "0.1.0",
  "description": "Blocks chosen websites and redirects them to a local blocked page.",
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content-script.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Open site blocker settings"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
